# Copy to .env (never committed). Only LLM_API_KEY has no default.

# The store (ADR 0006). The default matches docker-compose.yml.
DATABASE_URL=postgresql://lex:lex@127.0.0.1:5432/lex

# The answer model (ADR 0011): any OpenAI-compatible endpoint. Defaults: Google's Gemini layer,
# https://generativelanguage.googleapis.com/v1beta/openai/, and gemini-3.1-flash-lite.
# A local server: LLM_BASE_URL=http://127.0.0.1:8080/v1 (llama.cpp) or :1234/v1 (LM Studio),
# LLM_MODEL as the server names it, LLM_PARAMS={"seed": 0} (ADR 0012), any key.
LLM_API_KEY=
# "paid" if the key's Google project is billed; default free. Runs record the tier each model
# was called on; test runs may use the free tier since 2026-10-09 (ADR 0016, amended).
LLM_KEY_TIER=
# The judge (ADR 0015): Gemma 4 26B A4B on Google's API by default, which has no paid tier. A
# local server instead (llama.cpp, LM Studio): its URL and its name for the model. Another name
# is another judge, measured on dev again (python -m lex.eval judge-check).
JUDGE_BASE_URL=
JUDGE_MODEL=
# The judge's request parameters as a JSON object; default {"temperature": 0} (ADR 0011), {}
# for the provider's own. Other parameters are another judge, checked apart.
JUDGE_PARAMS=
LLM_BASE_URL=
LLM_MODEL=
# Request parameters as a JSON object; default {"reasoning_effort": "low"}, which is Gemini's.
LLM_PARAMS=
