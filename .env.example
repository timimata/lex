# Copy to .env (never committed). Only LLM_API_KEY has no default.

# The store (ADR 0006). The default matches docker-compose.yml.
DATABASE_URL=postgresql://lex:lex@127.0.0.1:5432/lex

# The answer model (ADR 0011): any OpenAI-compatible endpoint. Defaults: Google's Gemini layer,
# https://generativelanguage.googleapis.com/v1beta/openai/, and gemini-3.1-flash-lite.
# A local server: LLM_BASE_URL=http://127.0.0.1:8080/v1 (llama.cpp) or :1234/v1 (LM Studio),
# LLM_MODEL as the server names it, LLM_PARAMS={"seed": 0} (ADR 0012), any key.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Request parameters as a JSON object; default {"reasoning_effort": "low"}, which is Gemini's.
LLM_PARAMS=
